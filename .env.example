PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://healthcare:healthcare-dev-password@localhost:5433/healthcare
# Optional direct URL for Prisma migrations when DATABASE_URL uses a pool.
# MIGRATION_DATABASE_URL=postgresql://healthcare:password@localhost:5433/healthcare

BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-a-random-secret
JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-random-secret
JWT_RESET_SECRET=replace-with-a-random-secret
EXPRESS_SESSION_SECRET=replace-with-a-random-secret

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASS=replace-with-a-strong-password

SMTP_PORT=587
SMTP_FROM=Healthcare <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_USER=replace-me
SMTP_PASS=replace-me

FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
PARSE_API_KEY=replace-me

REDIS_USER=default
REDIS_PASS=replace-with-a-random-password
REDIS_HOST=localhost
REDIS_PORT=6379
